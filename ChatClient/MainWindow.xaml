<Window x:Class="ChatClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChatClient"
        mc:Ignorable="d"
        Title="💬 ChatClient"
        Height="700" Width="1050"
        MinHeight="550" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#0F0F13"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- ═══════════════════════════════════════════════════════
             COLORS & BRUSHES
             ═══════════════════════════════════════════════════════ -->
        <SolidColorBrush x:Key="BackgroundDark" Color="#0F0F13"/>
        <SolidColorBrush x:Key="BackgroundPanel" Color="#1A1A24"/>
        <SolidColorBrush x:Key="BackgroundCard" Color="#22223A"/>
        <SolidColorBrush x:Key="AccentPrimary" Color="#7C6EFF"/>
        <SolidColorBrush x:Key="AccentSecondary" Color="#C45AF9"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#2DCA7A"/>
        <SolidColorBrush x:Key="AccentRed" Color="#FF4F6B"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#EAEAF5"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8888AA"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2E2E48"/>

        <!-- Gradient nền header -->
        <LinearGradientBrush x:Key="GradientHeader" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#7C6EFF" Offset="0"/>
            <GradientStop Color="#C45AF9" Offset="1"/>
        </LinearGradientBrush>

        <!-- Gradient nút gửi -->
        <LinearGradientBrush x:Key="GradientButton" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#7C6EFF" Offset="0"/>
            <GradientStop Color="#C45AF9" Offset="1"/>
        </LinearGradientBrush>

        <!-- ═══════════════════════════════════════════════════════
             BUTTON STYLES
             ═══════════════════════════════════════════════════════ -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource GradientButton}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="#FF4F6B"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2E2E48"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="#222238"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI Emoji, Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2E2E50"/>
                                <Setter Property="BorderBrush" Value="#6C5CE7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style nút chuyển Tab danh mục Emoji -->
        <Style x:Key="EmojiTabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI Emoji, Segoe UI"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#383860"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style từng ô Emoji có hiệu ứng phát sáng khi hover -->
        <Style x:Key="EmojiItemButton" TargetType="Button">
            <Setter Property="Background" Value="#222238"/>
            <Setter Property="BorderBrush" Value="#353555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI Emoji, Segoe UI"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#3D3066"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#A29BFE"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#A29BFE" Opacity="0.7"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════
             TEXTBOX STYLE
             ═══════════════════════════════════════════════════════ -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#22223A"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════
             PASSWORDBOX STYLE
             ═══════════════════════════════════════════════════════ -->
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#22223A"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════
             MESSAGE BUBBLE DATATEMPLATE
             ═══════════════════════════════════════════════════════ -->
        <DataTemplate x:Key="MessageTemplate">
            <!-- Tin nhắn hệ thống: căn giữa -->
            <Grid Margin="0,4">
                <!-- Tin nhắn hệ thống -->
                <Border x:Name="SystemBorder"
                        HorizontalAlignment="Center"
                        Background="#1E1E30"
                        CornerRadius="12"
                        Padding="12,6"
                        Visibility="Collapsed">
                    <TextBlock Text="{Binding Content}"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11"
                               FontStyle="Italic"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- Bong bóng tin nhắn -->
                <StackPanel x:Name="BubblePanel"
                            HorizontalAlignment="Right">
                    <!-- Tên người gửi (cho tin nhắn đến) -->
                    <TextBlock x:Name="SenderLabel"
                               Text="{Binding SenderName}"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11"
                               Margin="4,0,4,2"
                               HorizontalAlignment="Left"
                               Visibility="Collapsed"/>

                    <Border x:Name="Bubble"
                            Background="{StaticResource GradientButton}"
                            CornerRadius="16,4,16,16"
                            Padding="12,8"
                            MaxWidth="400"
                            HorizontalAlignment="Right">
                        <StackPanel>
                            <!-- Tin nhắn văn bản hỗ trợ Color Emoji đa sắc -->
                            <TextBlock x:Name="TxtMsgContent"
                                       local:EmojiHelper.FormattedText="{Binding Content}"
                                       Foreground="White"
                                       FontSize="13"
                                       FontFamily="Segoe UI"
                                       TextWrapping="Wrap"/>

                            <!-- Tin nhắn hình ảnh -->
                            <Border x:Name="ImgContainer"
                                    CornerRadius="10"
                                    ClipToBounds="True"
                                    Margin="0,0,0,4"
                                    MaxWidth="320"
                                    MaxHeight="280"
                                    Visibility="Collapsed">
                                <Image Source="{Binding ImageSource}"
                                       Stretch="Uniform"
                                       Cursor="Hand"
                                       MouseLeftButtonUp="Image_MouseLeftButtonUp"/>
                            </Border>

                            <!-- Tin nhắn tập tin -->
                            <Border x:Name="FileCard"
                                    Background="#1C1C30"
                                    BorderBrush="#3D3D58"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10,8"
                                    Margin="0,0,0,4"
                                    MinWidth="220"
                                    MaxWidth="320"
                                    Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="📄" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" Foreground="White" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding FileSizeFormatted}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Content="⬇"
                                            ToolTip="Tải tập tin về máy"
                                            Style="{StaticResource IconButton}"
                                            Width="32" Height="32"
                                            FontSize="14"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Click="BtnDownloadFile_Click"/>
                                </Grid>
                            </Border>

                            <!-- Thời gian -->
                            <TextBlock Text="{Binding DisplayTime}"
                                       Foreground="#CCBBFF"
                                       FontSize="10"
                                       HorizontalAlignment="Right"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <DataTemplate.Triggers>
                <!-- Nếu là tin nhắn hệ thống -->
                <DataTrigger Binding="{Binding IsSystemMessage}" Value="True">
                    <Setter TargetName="SystemBorder" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="BubblePanel" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <!-- Nếu là hình ảnh -->
                <DataTrigger Binding="{Binding IsImageMessage}" Value="True">
                    <Setter TargetName="TxtMsgContent" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="ImgContainer" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="FileCard" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <!-- Nếu là file -->
                <DataTrigger Binding="{Binding IsFileMessage}" Value="True">
                    <Setter TargetName="TxtMsgContent" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="ImgContainer" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="FileCard" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <!-- Nếu là tin nhắn đến (không phải của mình) -->
                <DataTrigger Binding="{Binding IsOutgoing}" Value="False">
                    <Setter TargetName="BubblePanel" Property="HorizontalAlignment" Value="Left"/>
                    <Setter TargetName="Bubble" Property="Background" Value="#22223A"/>
                    <Setter TargetName="Bubble" Property="CornerRadius" Value="4,16,16,16"/>
                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Left"/>
                    <Setter TargetName="SenderLabel" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ═══════════════════════════════════════════════════════
             SCROLLBAR STYLE (ẩn, chỉ hiện khi hover)
             ═══════════════════════════════════════════════════════ -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineUpCommand"
                                                  Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Background="#44446A"
                                                                    CornerRadius="3"
                                                                    Margin="1"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineDownCommand"
                                                  Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ═══════════════════════════════════════════════════════════
         MAIN LAYOUT
         ═══════════════════════════════════════════════════════════ -->
    <Grid>
        <!-- Panel kết nối / xác thực (hiển thị khi chưa login) -->
        <Grid x:Name="AuthPanel" Panel.ZIndex="10">
            <Border Background="{StaticResource BackgroundDark}">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Width="380">
                    <!-- Logo / Title -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,32">
                        <TextBlock Text="💬"
                                   FontSize="52"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="ChatClient"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   FontFamily="Segoe UI"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Kết nối, Trò chuyện, Chia sẻ"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="13"
                                   FontFamily="Segoe UI"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Card kết nối -->
                    <Border Background="{StaticResource BackgroundPanel}"
                            CornerRadius="16"
                            Padding="28"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <!-- Cấu hình Server -->
                            <TextBlock Text="Cấu hình Server"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       FontFamily="Segoe UI"
                                       Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtHost"
                                         Grid.Column="0"
                                         Style="{StaticResource ModernTextBox}"
                                         Text="127.0.0.1"
                                         Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtPort"
                                         Grid.Column="1"
                                         Style="{StaticResource ModernTextBox}"
                                         Text="5000"/>
                            </Grid>

                            <!-- Divider -->
                            <Separator Background="{StaticResource BorderBrush}"
                                       Margin="0,4,0,16"/>

                            <!-- Tab: Login / Register -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnTabLogin"
                                        Grid.Column="0"
                                        Content="Đăng Nhập"
                                        Style="{StaticResource PrimaryButton}"
                                        Padding="0,8"
                                        Margin="0,0,4,0"
                                        Click="BtnTabLogin_Click"/>
                                <Button x:Name="BtnTabRegister"
                                        Grid.Column="1"
                                        Content="Đăng Ký"
                                        Style="{StaticResource GhostButton}"
                                        Padding="0,8"
                                        Margin="4,0,0,0"
                                        Click="BtnTabRegister_Click"/>
                            </Grid>

                            <!-- Form Fields -->
                            <TextBlock Text="Tên đăng nhập"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="12"
                                       FontFamily="Segoe UI"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtUsername"
                                     Style="{StaticResource ModernTextBox}"
                                     Margin="0,0,0,12"
                                     KeyDown="TxtInput_KeyDown"/>

                            <!-- DisplayName (chỉ hiện khi Register) -->
                            <StackPanel x:Name="RegisterOnlyPanel" Visibility="Collapsed">
                                <TextBlock Text="Tên hiển thị"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="12"
                                           FontFamily="Segoe UI"
                                           Margin="0,0,0,6"/>
                                <TextBox x:Name="TxtDisplayName"
                                         Style="{StaticResource ModernTextBox}"
                                         Margin="0,0,0,12"/>
                            </StackPanel>

                            <TextBlock Text="Mật khẩu"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="12"
                                       FontFamily="Segoe UI"
                                       Margin="0,0,0,6"/>
                            <PasswordBox x:Name="TxtPassword"
                                         Style="{StaticResource ModernPasswordBox}"
                                         Margin="0,0,0,20"
                                         KeyDown="TxtInput_KeyDown"/>

                            <!-- Thông báo lỗi -->
                            <Border x:Name="ErrorBorder"
                                    Background="#3B1E24"
                                    CornerRadius="8"
                                    Padding="12,8"
                                    Margin="0,0,0,12"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="TxtErrorMsg"
                                           Foreground="{StaticResource AccentRed}"
                                           FontSize="12"
                                           FontFamily="Segoe UI"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <!-- Nút hành động chính -->
                            <Button x:Name="BtnConnect"
                                    Content="Đăng Nhập"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="0,12"
                                    FontSize="14"
                                    Click="BtnConnect_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ════════════════════════════════════════════════════════
             CHAT PANEL (hiển thị sau khi đã đăng nhập)
             ════════════════════════════════════════════════════════ -->
        <Grid x:Name="ChatPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <!-- Header -->
                <RowDefinition Height="64"/>
                <!-- Nội dung chính -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── HEADER ──────────────────────────────────────── -->
            <Border Grid.Row="0"
                    Background="{StaticResource BackgroundPanel}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo & Tên người dùng -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="💬"
                                   FontSize="24"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ChatClient"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       FontFamily="Segoe UI"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8"
                                         Fill="{StaticResource AccentGreen}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,5,0"/>
                                <TextBlock x:Name="TxtCurrentUser"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="12"
                                           FontFamily="Segoe UI"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Nút Refresh & Đăng xuất -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Content="🔄 Làm mới"
                                Style="{StaticResource GhostButton}"
                                Padding="12,6"
                                Margin="0,0,8,0"
                                Click="BtnRefresh_Click"/>
                        <Button Content="🚪 Đăng xuất"
                                Style="{StaticResource DangerButton}"
                                Padding="12,6"
                                Click="BtnLogout_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── NỘI DUNG CHÍNH ──────────────────────────────── -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Sidebar: Danh sách cuộc hội thoại / Người dùng online -->
                    <ColumnDefinition Width="260"/>
                    <!-- Khu vực chat -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── SIDEBAR ───────────────────────────────── -->
                <Border Grid.Column="0"
                        Background="{StaticResource BackgroundPanel}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Tab -->
                            <RowDefinition Height="Auto"/>
                            <!-- Nút tạo mới + Danh sách -->
                            <RowDefinition Height="*"/>
                            <!-- Danh sách online -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Tab Conversations / Online -->
                        <Grid Grid.Row="0" Margin="12,12,12,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnTabConversations"
                                    Grid.Column="0"
                                    Content="Hội Thoại"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="0,7"
                                    FontSize="12"
                                    Margin="0,0,4,0"
                                    Click="BtnTabConversations_Click"/>
                            <Button x:Name="BtnTabOnline"
                                    Grid.Column="1"
                                    Content="Online"
                                    Style="{StaticResource GhostButton}"
                                    Padding="0,7"
                                    FontSize="12"
                                    Margin="4,0,0,0"
                                    Click="BtnTabOnline_Click"/>
                        </Grid>

                        <!-- Danh sách hội thoại -->
                        <Grid x:Name="ConversationsPanel" Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0"
                                    Content="＋ Tạo hội thoại mới"
                                    Style="{StaticResource GhostButton}"
                                    Padding="10,8"
                                    Margin="12,0,12,8"
                                    HorizontalAlignment="Stretch"
                                    Click="BtnNewConversation_Click"/>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ListBox x:Name="LstConversations"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         SelectionChanged="LstConversations_SelectionChanged">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="12,10"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                            <Setter Property="FontFamily" Value="Segoe UI"/>
                                            <Setter Property="FontSize" Value="13"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="ItemBorder"
                                                                Background="{TemplateBinding Background}"
                                                                CornerRadius="8"
                                                                Margin="4,2"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="Background" Value="#2A2A42"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="Background" Value="#33336A"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimary}"/>
                                                <TextBlock Text="{Binding TypeLabel}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </Grid>

                        <!-- Danh sách người dùng online -->
                        <Grid x:Name="OnlineUsersPanel"
                              Grid.Row="1"
                              Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="LstOnlineUsers"
                                              Margin="8,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="12,8" Margin="0,2"
                                                    CornerRadius="8">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8"
                                                             Fill="{StaticResource AccentGreen}"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               Foreground="{StaticResource TextPrimary}"
                                                               FontFamily="Segoe UI"
                                                               FontSize="13"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- Số người online ở bottom sidebar -->
                        <Border Grid.Row="2"
                                Background="#16162A"
                                Padding="12,10"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,1,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8"
                                         Fill="{StaticResource AccentGreen}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtOnlineCount"
                                           Text="0 người online"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="12"
                                           FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ── KHU VỰC CHAT ───────────────────────────── -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <!-- Tiêu đề cuộc hội thoại -->
                        <RowDefinition Height="56"/>
                        <!-- Danh sách tin nhắn -->
                        <RowDefinition Height="*"/>
                        <!-- Ô nhập tin nhắn -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Tiêu đề cuộc hội thoại -->
                    <Border Grid.Row="0"
                            Background="{StaticResource BackgroundPanel}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="20,0">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtConversationTitle"
                                           Text="Chọn một cuộc hội thoại để bắt đầu"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           FontFamily="Segoe UI"/>
                                <TextBlock x:Name="TxtConversationType"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="11"
                                           FontFamily="Segoe UI"/>
                            </StackPanel>

                            <!-- Nút tải lịch sử thêm -->
                            <Button x:Name="BtnLoadMore"
                                    Content="⬆ Tải thêm"
                                    Style="{StaticResource GhostButton}"
                                    Padding="10,5"
                                    HorizontalAlignment="Right"
                                    Visibility="Collapsed"
                                    Click="BtnLoadMore_Click"/>
                        </Grid>
                    </Border>

                    <!-- Danh sách tin nhắn -->
                    <ScrollViewer x:Name="MessagesScroll"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Background="{StaticResource BackgroundDark}"
                                  Padding="16,12">
                        <ItemsControl x:Name="LstMessages"
                                      ItemTemplate="{StaticResource MessageTemplate}">
                            <!-- Placeholder khi chưa có tin nhắn -->
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Style.Triggers>
                                        <Trigger Property="HasItems" Value="False">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate>
                                                        <TextBlock Text="Chưa có tin nhắn nào. Hãy bắt đầu cuộc trò chuyện! 👋"
                                                                   Foreground="{StaticResource TextSecondary}"
                                                                   FontFamily="Segoe UI"
                                                                   FontSize="14"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,60,0,0"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Ô nhập tin nhắn -->
                    <Border Grid.Row="2"
                            Background="{StaticResource BackgroundPanel}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Các nút tiện ích: Emoji, Hình ảnh, Tập tin -->
                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,0">
                                <!-- Nút Emoji -->
                                <Button x:Name="BtnEmoji"
                                        ToolTip="Chọn biểu tượng cảm xúc"
                                        Style="{StaticResource IconButton}"
                                        Width="38" Height="38"
                                        Margin="0,0,4,0"
                                        IsEnabled="False"
                                        Click="BtnEmoji_Click">
                                    <Image Source="Assets/Emojis/1f600.png" Width="22" Height="22" Stretch="Uniform"/>
                                </Button>

                                <!-- Popup Emoji Picker với viền Gradient & bóng phát sáng rực rỡ -->
                                <Popup x:Name="EmojiPopup"
                                       PlacementTarget="{Binding ElementName=BtnEmoji}"
                                       Placement="Top"
                                       StaysOpen="False"
                                       AllowsTransparency="True"
                                       PopupAnimation="Fade"
                                       VerticalOffset="-8">
                                    <Border Background="#161626"
                                            BorderThickness="1.5"
                                            CornerRadius="16"
                                            Padding="14"
                                            Width="360"
                                            MaxHeight="340">
                                        <!-- Viền Gradient đa sắc: Tím neon -> Hồng -> Cam vàng -->
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#6C5CE7" Offset="0.0"/>
                                                <GradientStop Color="#FD79A8" Offset="0.5"/>
                                                <GradientStop Color="#FFAA00" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.55" Color="#6C5CE7"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <!-- Tiêu đề & Tag loại -->
                                                <RowDefinition Height="Auto"/>
                                                <!-- Thanh Tab phân loại -->
                                                <RowDefinition Height="Auto"/>
                                                <!-- Danh sách Emoji -->
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- Header -->
                                            <Grid Grid.Row="0" Margin="2,0,2,10">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="✨" FontSize="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="BẢNG BIỂU TƯỢNG CẢM XÚC"
                                                               Foreground="White"
                                                               FontWeight="Bold"
                                                               FontSize="12"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Border HorizontalAlignment="Right"
                                                        Background="#282845"
                                                        CornerRadius="8"
                                                        Padding="8,2">
                                                    <TextBlock x:Name="TxtEmojiCategoryTitle"
                                                               Text="Mặt cười &amp; Cảm xúc"
                                                               Foreground="#FD79A8"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>

                                            <!-- Category Tabs -->
                                            <Border Grid.Row="1"
                                                    Background="#1F1F35"
                                                    CornerRadius="10"
                                                    Padding="4"
                                                    Margin="0,0,0,10">
                                                <UniformGrid Columns="6" x:Name="EmojiCategoryTabs">
                                                    <Button Tag="smileys" ToolTip="Mặt cười &amp; Cảm xúc" Style="{StaticResource EmojiTabButton}" Click="EmojiCategory_Click">
                                                        <Image Source="Assets/Emojis/1f600.png" Width="22" Height="22" Stretch="Uniform"/>
                                                    </Button>
                                                    <Button Tag="hearts" ToolTip="Tình cảm &amp; Trái tim" Style="{StaticResource EmojiTabButton}" Click="EmojiCategory_Click">
                                                        <Image Source="Assets/Emojis/2764.png" Width="22" Height="22" Stretch="Uniform"/>
                                                    </Button>
                                                    <Button Tag="gestures" ToolTip="Cử chỉ &amp; Bàn tay" Style="{StaticResource EmojiTabButton}" Click="EmojiCategory_Click">
                                                        <Image Source="Assets/Emojis/1f44d.png" Width="22" Height="22" Stretch="Uniform"/>
                                                    </Button>
                                                    <Button Tag="food" ToolTip="Đồ ăn &amp; Thức uống" Style="{StaticResource EmojiTabButton}" Click="EmojiCategory_Click">
                                                        <Image Source="Assets/Emojis/1f354.png" Width="22" Height="22" Stretch="Uniform"/>
                                                    </Button>
                                                    <Button Tag="fun" ToolTip="Tiệc tùng &amp; Hoạt động" Style="{StaticResource EmojiTabButton}" Click="EmojiCategory_Click">
                                                        <Image Source="Assets/Emojis/1f389.png" Width="22" Height="22" Stretch="Uniform"/>
                                                    </Button>
                                                    <Button Tag="objects" ToolTip="Đồ vật &amp; Biểu tượng" Style="{StaticResource EmojiTabButton}" Click="EmojiCategory_Click">
                                                        <Image Source="Assets/Emojis/1f680.png" Width="22" Height="22" Stretch="Uniform"/>
                                                    </Button>
                                                </UniformGrid>
                                            </Border>

                                            <!-- Danh sách Emoji có cuộn mượt mà -->
                                            <ScrollViewer Grid.Row="2"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          MaxHeight="210">
                                                <WrapPanel x:Name="EmojiContainer" HorizontalAlignment="Center"/>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                </Popup>

                                <!-- Nút gửi Ảnh -->
                                <Button x:Name="BtnSendImage"
                                        Content="🖼"
                                        ToolTip="Gửi hình ảnh"
                                        Style="{StaticResource IconButton}"
                                        FontSize="16"
                                        Width="38" Height="38"
                                        Margin="0,0,4,0"
                                        IsEnabled="False"
                                        Click="BtnSendImage_Click"/>

                                <!-- Nút gửi File -->
                                <Button x:Name="BtnSendFile"
                                        Content="📎"
                                        ToolTip="Gửi tập tin đính kèm"
                                        Style="{StaticResource IconButton}"
                                        FontSize="16"
                                        Width="38" Height="38"
                                        IsEnabled="False"
                                        Click="BtnSendFile_Click"/>
                            </StackPanel>

                            <TextBox x:Name="TxtMessage"
                                     Grid.Column="1"
                                     Style="{StaticResource ModernTextBox}"
                                     Padding="14,10"
                                     FontSize="14"
                                     AcceptsReturn="False"
                                     MaxLength="2000"
                                     Margin="0,0,10,0"
                                     KeyDown="TxtMessage_KeyDown"
                                     IsEnabled="False"/>

                            <Button x:Name="BtnSend"
                                     Grid.Column="2"
                                     Content="➤ Gửi"
                                     Style="{StaticResource PrimaryButton}"
                                     Padding="18,10"
                                     FontSize="14"
                                     IsEnabled="False"
                                     Click="BtnSend_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Overlay Loading -->
        <Grid x:Name="LoadingOverlay"
              Panel.ZIndex="20"
              Visibility="Collapsed"
              Background="#88000000">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock Text="⏳"
                           FontSize="36"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtLoadingMsg"
                           Text="Đang kết nối..."
                           Foreground="White"
                           FontSize="14"
                           FontFamily="Segoe UI"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
