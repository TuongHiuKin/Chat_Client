@{
    ViewData["Title"] = "Lab 3 - Real-Time Chat (SignalR)";
}

<div class="row justify-content-center mt-3">
    <div class="col-lg-9 col-md-11">
        <div class="card shadow border-0 chat-card">
            <!-- Chat Card Header -->
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-4">💬</span>
                    <div>
                        <h5 class="mb-0 fw-bold">Lab 3: Real-Time Web Chat</h5>
                        <small class="text-white-50">SignalR • Emojis • Gửi ảnh xem trước • Truyền file tới 500MB</small>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span id="connectionBadge" class="badge bg-warning text-dark">Connecting...</span>
                    <span id="userCountBadge" class="badge bg-light text-dark">Users online: 0</span>
                </div>
            </div>

            <div class="card-body p-3 position-relative">
                <!-- Display Name Section -->
                <div class="row g-2 mb-3 align-items-center bg-light p-2 rounded border">
                    <div class="col-sm-3 col-form-label">
                        <label for="userInput" class="fw-bold mb-0 text-secondary">👤 Tên hiển thị:</label>
                    </div>
                    <div class="col-sm-6">
                        <input type="text" id="userInput" class="form-control" placeholder="Nhập tên của bạn (ví dụ: Kien, Vy)..." maxlength="50" autocomplete="off" />
                    </div>
                    <div class="col-sm-3">
                        <button type="button" id="joinButton" class="btn btn-primary w-100 fw-semibold">
                            Tham gia Chat
                        </button>
                    </div>
                </div>

                <!-- Alert for validation or notifications -->
                <div id="validationAlert" class="alert alert-danger py-2 mb-2 d-none" role="alert"></div>

                <!-- Scrollable Messages Area -->
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label class="fw-bold text-muted small mb-0">Hộp thoại trò chuyện</label>
                    <span id="typingStatus" class="small text-muted fst-italic"></span>
                </div>
                <div id="messagesContainer" class="border rounded p-3 mb-2 bg-white" style="height: 420px; overflow-y: auto;">
                    <div id="messagesList" class="d-flex flex-column gap-2">
                        <!-- Tin nhắn sẽ được thêm vào đây bằng chat.js -->
                    </div>
                </div>

                <!-- Upload Progress Indicator (ẩn mặc định) -->
                <div id="uploadProgressWrapper" class="card p-2 mb-2 border-primary bg-light d-none">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span id="uploadFileName" class="fw-bold small text-truncate" style="max-width: 60%;">Đang gửi file...</span>
                        <div class="d-flex align-items-center gap-2">
                            <span id="uploadStatusText" class="small text-muted">0%</span>
                            <button type="button" id="cancelUploadBtn" class="btn btn-outline-danger btn-sm py-0 px-2" style="font-size: 0.75rem;">Hủy</button>
                        </div>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div id="uploadProgressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" style="width: 0%;"></div>
                    </div>
                </div>

                <!-- Emoji Picker Popover (ẩn mặc định) -->
                <div id="emojiPicker" class="card shadow-lg border emoji-picker d-none">
                    <div class="card-header bg-light py-2 px-2 d-flex justify-content-between align-items-center">
                        <div class="nav nav-pills nav-fill flex-nowrap overflow-auto gap-1" id="emojiTabs" role="tablist">
                            <button class="nav-link active py-1 px-2 btn-sm emoji-tab-btn" data-category="smileys" title="Mặt cười & Cảm xúc">😀</button>
                            <button class="nav-link py-1 px-2 btn-sm emoji-tab-btn" data-category="hearts" title="Tình cảm & Trái tim">❤️</button>
                            <button class="nav-link py-1 px-2 btn-sm emoji-tab-btn" data-category="gestures" title="Cử chỉ & Bàn tay">👍</button>
                            <button class="nav-link py-1 px-2 btn-sm emoji-tab-btn" data-category="food" title="Đồ ăn & Thức uống">🍔</button>
                            <button class="nav-link py-1 px-2 btn-sm emoji-tab-btn" data-category="fun" title="Tiệc tùng & Hoạt động">🎉</button>
                            <button class="nav-link py-1 px-2 btn-sm emoji-tab-btn" data-category="objects" title="Đồ vật & Biểu tượng">🚀</button>
                        </div>
                        <button type="button" id="closeEmojiPickerBtn" class="btn-close ms-2" aria-label="Close"></button>
                    </div>
                    <div class="card-body p-2 emoji-grid" id="emojiGrid">
                        <!-- Danh sách emoji động load ở đây -->
                    </div>
                </div>

                <!-- Chat Actions Toolbar & Inputs -->
                <div class="chat-input-wrapper">
                    <!-- File inputs (ẩn) -->
                    <input type="file" id="imageFileInput" accept="image/png,image/jpeg,image/jpg,image/gif,image/bmp,image/webp" class="d-none" />
                    <input type="file" id="generalFileInput" class="d-none" />

                    <div class="input-group">
                        <!-- Nút mở emoji picker -->
                        <button type="button" id="emojiToggleBtn" class="btn btn-outline-secondary" title="Chọn emoji" disabled>
                            😊
                        </button>
                        <!-- Nút gửi ảnh -->
                        <button type="button" id="pickImageBtn" class="btn btn-outline-secondary" title="Gửi hình ảnh có xem trước" disabled>
                            🖼️ <span class="d-none d-sm-inline">Ảnh</span>
                        </button>
                        <!-- Nút gửi file -->
                        <button type="button" id="pickFileBtn" class="btn btn-outline-secondary" title="Gửi tệp tin (tối đa 500 MB)" disabled>
                            📎 <span class="d-none d-sm-inline">File</span>
                        </button>

                        <!-- Input tin nhắn văn bản -->
                        <input type="text" id="messageInput" class="form-control" placeholder="Nhập tin nhắn (nhấn Enter để gửi)..." maxlength="500" disabled autocomplete="off" />

                        <!-- Nút gửi -->
                        <button type="button" id="sendButton" class="btn btn-primary px-4 fw-semibold" disabled>
                            Gửi
                        </button>
                    </div>
                </div>

                <!-- Footer Utilities (Bộ đếm ký tự & Nút xóa tin nhắn) -->
                <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                    <small class="text-muted" id="charCount">0 / 500 ký tự</small>
                    <div>
                        <button type="button" id="clearChatButton" class="btn btn-link btn-sm text-decoration-none text-muted p-0">
                            🗑️ Xóa tin nhắn màn hình
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================== -->
<!-- Modal 1: Xem trước ảnh trước khi gửi (Giống hệt Lab 2)            -->
<!-- ============================================================== -->
<div class="modal fade" id="imagePreviewModal" tabindex="-1" aria-labelledby="imagePreviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content shadow border-0">
            <div class="modal-header bg-primary text-white py-2">
                <h6 class="modal-title" id="imagePreviewModalLabel">
                    🖼️ Xem trước: <span id="previewModalFileName"></span>
                </h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3 text-center bg-light">
                <div class="image-preview-container mb-3 border rounded bg-white p-2" style="max-height: 400px; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                    <img id="previewModalImage" src="" alt="Xem trước ảnh" class="img-fluid rounded" style="max-height: 380px; object-fit: contain;" />
                </div>
                <div class="d-flex justify-content-between text-muted small px-1 mb-2">
                    <span id="previewModalFileSize">Kích thước: 0 KB</span>
                    <span id="previewModalFileType">Định dạng ảnh</span>
                </div>
                <!-- Chú thích ảnh (tùy chọn) -->
                <div class="text-start">
                    <label for="previewModalCaption" class="form-label small fw-bold text-secondary mb-1">Chú thích ảnh (tùy chọn):</label>
                    <input type="text" id="previewModalCaption" class="form-control" placeholder="Nhập lời nhắn kèm ảnh..." maxlength="200" autocomplete="off" />
                </div>
            </div>
            <div class="modal-footer py-2 bg-white">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="button" id="confirmSendImageBtn" class="btn btn-primary px-4 fw-bold">
                    🚀 Gửi ảnh ngay
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================== -->
<!-- Modal 2: Phóng to ảnh trong lịch sử chat (Lightbox Modal)      -->
<!-- ============================================================== -->
<div class="modal fade" id="lightboxModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content bg-dark text-white border-0">
            <div class="modal-header border-secondary py-2">
                <h6 class="modal-title text-truncate" id="lightboxTitle">Xem ảnh</h6>
                <div class="d-flex align-items-center gap-2">
                    <a id="lightboxDownloadBtn" href="#" download="" class="btn btn-sm btn-outline-light">
                        ⬇️ Tải ảnh gốc
                    </a>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>
            <div class="modal-body p-2 text-center" style="max-height: 80vh; overflow: auto;">
                <img id="lightboxImage" src="" alt="Ảnh phóng to" class="img-fluid rounded" style="max-height: 75vh; object-fit: contain;" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- SignalR Client Library (Local with CDN fallback) -->
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script>
        if (typeof signalR === 'undefined') {
            document.write('<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"><\/script>');
        }
    </script>
    <!-- Chat Client Logic -->
    <script src="~/js/chat.js" asp-append-version="true"></script>
}
