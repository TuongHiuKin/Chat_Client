@{
    ViewData["Title"] = "Lab 3 - Real-Time Chat";
}

<div class="row justify-content-center mt-3">
    <div class="col-lg-8 col-md-10">
        <div class="card shadow-sm border-0">
            <!-- Chat Card Header -->
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
                <div class="d-flex align-items-center">
                    <span class="fs-5 me-2">💬</span>
                    <h5 class="mb-0">Lab 3: Online Chat (SignalR)</h5>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span id="connectionBadge" class="badge bg-warning text-dark">Connecting...</span>
                    <span id="userCountBadge" class="badge bg-light text-dark">Users online: 0</span>
                </div>
            </div>

            <div class="card-body p-3">
                <!-- Display Name Section -->
                <div class="row g-2 mb-3 align-items-center">
                    <div class="col-sm-3 col-form-label">
                        <label for="userInput" class="fw-bold mb-0">Display Name:</label>
                    </div>
                    <div class="col-sm-6">
                        <input type="text" id="userInput" class="form-control" placeholder="Enter your display name (e.g. Kien)" maxlength="50" autocomplete="off" />
                    </div>
                    <div class="col-sm-3">
                        <button type="button" id="joinButton" class="btn btn-outline-primary w-100">Set Name / Join</button>
                    </div>
                </div>

                <!-- Alert for validation or connection notifications -->
                <div id="validationAlert" class="alert alert-danger py-2 mb-2 d-none" role="alert"></div>

                <!-- Scrollable Messages Area -->
                <label class="fw-bold text-muted small mb-1">Messages</label>
                <div id="messagesContainer" class="border rounded p-3 mb-3 bg-light" style="height: 380px; overflow-y: auto;">
                    <div id="messagesList" class="d-flex flex-column gap-2">
                        <!-- Messages dynamically added here via chat.js -->
                    </div>
                </div>

                <!-- Message Input & Send Actions -->
                <div class="row g-2">
                    <div class="col">
                        <div class="input-group">
                            <input type="text" id="messageInput" class="form-control" placeholder="Type a message (Press Enter to send)..." maxlength="500" disabled autocomplete="off" />
                            <button type="button" id="sendButton" class="btn btn-primary px-4" disabled>
                                Send
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Footer Action Utilities (Clear, Status) -->
                <div class="d-flex justify-content-between align-items-center mt-2 pt-1 border-top">
                    <small class="text-muted" id="charCount">0 / 500 characters</small>
                    <button type="button" id="clearChatButton" class="btn btn-link btn-sm text-decoration-none text-muted p-0">Clear Local Messages</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- SignalR Client Library (Local with CDN fallback) -->
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script>
        if (typeof signalR === 'undefined') {
            document.write('<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"><\/script>');
        }
    </script>
    <!-- Chat Client Logic -->
    <script src="~/js/chat.js" asp-append-version="true"></script>
}
